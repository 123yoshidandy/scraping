[
  {
    "name": "pokemon-center-restock-list",
    "description": "ポケモンセンターオンラインの「再入荷」一覧に新しい商品が追加された（再販の検知）",
    "url": "https://www.pokemoncenter-online.com/search/?prefn1=releaseType&prefv1=2&srule=top-new-product&sz=1000",
    "triggerWhen": {
      "type": "items_added",
      "selector": "ul.product-grid li.product",
      "keyAttribute": "data-pid",
      "labelSelector": ".txtBox .txt a"
    },
    "requireSelector": "ul.product-grid"
  },
  {
    "name": "amazon-30th-celebration-box",
    "description": "MEGA拡張パック 30th CELEBRATION BOX が Amazon で定価相当（7,300円以下）で購入可能になった（定価7,200円 / 相場は定価の2〜3倍）",
    "url": "https://www.amazon.co.jp/dp/B0GXCRBL5J",
    "triggerWhen": {
      "type": "all_of",
      "rules": [
        {
          "type": "text_absent",
          "text": "招待された方のみ"
        },
        {
          "type": "number_at_most",
          "selector": "#corePrice_feature_div .a-price-whole",
          "max": 7300
        },
        {
          "type": "selector_exists",
          "selector": "#add-to-cart-button"
        }
      ]
    },
    "requireSelector": "#productTitle"
  },
  {
